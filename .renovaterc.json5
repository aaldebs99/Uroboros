{
  // Renovate policy for Uroboros. STANDALONE on purpose: no `local>` / `github>` preset
  // extends beyond Renovate's own built-ins, so a fork works on any forge without access to
  // anyone else's shared-config repo. Everything a shared preset would carry is vendored below.
  //
  // RULE ORDER MATTERS: packageRules are applied top to bottom and a LATER matching rule wins
  // for every key it sets. The layout is therefore:
  //   1. labels + semantic-commit wording (cosmetic, set per update type / manager)
  //   2. automerge policy (broad)
  //   3. toolchain groups (narrow; they override automerge back to manual)
  //   4. manager-specific fixes (narrowest)
  // Put a new broad rule above the groups, or it will silently undo them.
  //
  // Validate with `mise run lint:renovate` (a CI gate).
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Docker majors are off by default in config:recommended; base images need them.
    "docker:enableMajor",
    // `uses: owner/action@<full sha> # vX.Y.Z` — pin by digest, keep the semver comment current.
    "helpers:pinGitHubActionDigestsToSemver",
    ":dependencyDashboard",
  ],
  dependencyDashboardTitle: "Renovate Dashboard",

  // Renovate merges its own PRs, and only after reading every status check as green.
  //
  // automergeType "pr" (not "branch"): CI runs on `pull_request`, so a bare renovate/* branch
  // never gets checks and a branch automerge would wait forever.
  //
  // platformAutomerge false: Renovate defaults it to TRUE, which asks the forge to "merge when
  // checks succeed" in the same call that opens the PR. Some forges (Gitea among them) treat a base
  // branch without a protected-branch rule as "checks passed" without reading a single status
  // and merge within seconds, CI still pending. With it false, Renovate itself verifies the
  // statuses on every platform.
  automergeType: "pr",
  platformAutomerge: false,

  // Only rebase a Renovate branch when it actually CONFLICTS, not every time main moves.
  // "behind-base-branch" force-rebases every open branch on each run, restarting CI each time; on
  // a busy repo a branch is then never simultaneously up to date AND green when Renovate looks,
  // so automerge never fires. A behind-but-clean branch still merges fine.
  rebaseWhen: "conflicted",

  // No cap on new or open PRs (config:recommended sets 2 an hour and 10 open). Renovate runs twice
  // a day, so the hourly cap meant four PRs a day and a queue that never drained; the soak below
  // and automerge on green CI are what pace updates here. Djinn's policy, the same two keys.
  prHourlyLimit: 0,
  prConcurrentLimit: 0,

  // Supply-chain soak: nothing is proposed until it has been public for 3 days, so a compromised
  // or broken release has time to be yanked first. Top-level, so it covers every manager — mise
  // tools and CI actions included, both of which run code on every machine.
  //
  // pnpm-workspace.yaml sets `minimumReleaseAge: 4320` (minutes) = the same 3 days, and pnpm
  // refuses to write a lockfile containing anything younger (ERR_PNPM_NO_MATURE_MATCHING_VERSION).
  // If the two disagree, Renovate opens PRs whose lockfile update fails. Keep this literal in step
  // with that number: change both together.
  minimumReleaseAge: "3 days",

  // Refresh transitive deps in pnpm-lock.yaml once a month.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 4am on the first day of the month"],
    automerge: true,
  },

  packageRules: [
    // ── 1. Labels ──────────────────────────────────────────────────────────────────────────────
    { matchUpdateTypes: ["major"], labels: ["type/major"] },
    { matchUpdateTypes: ["minor"], labels: ["type/minor"] },
    { matchUpdateTypes: ["patch"], labels: ["type/patch"] },
    { matchUpdateTypes: ["digest"], labels: ["type/digest"] },

    // ── 1. Semantic commits: `<type>(<scope>): update <topic> (v1 → v2)` ────────────────────
    // Majors are breaking feats (`!`), minors feats, patch/digest fixes. cliff.toml groups the
    // changelog on exactly these types.
    {
      matchUpdateTypes: ["major"],
      semanticCommitType: "feat",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}})!:",
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
    },
    {
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
    },
    {
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
    },
    {
      matchUpdateTypes: ["digest"],
      semanticCommitType: "fix",
      commitMessageExtra: "({{currentDigestShort}} → {{newDigestShort}})",
    },
    // Per-manager scopes. Tooling bumps (mise, CI actions) are chore/ci so they never read as
    // product features or breaking changes; the `!` prefix is dropped for them too.
    {
      matchManagers: ["npm"],
      semanticCommitScope: "npm",
      commitMessageTopic: "package {{depName}}",
    },
    {
      matchDatasources: ["docker"],
      semanticCommitScope: "container",
      commitMessageTopic: "image {{depName}}",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}}):",
    },
    {
      matchManagers: ["mise"],
      semanticCommitType: "chore",
      semanticCommitScope: "mise",
      commitMessageTopic: "tool {{depName}}",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}}):",
    },

    // ── 2. Automerge (after the soak, and only on green CI) ──────────────────────────────────
    {
      description: "Automerge patch + digest updates",
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
    },
    {
      // npm packages are semver-disciplined and every bump is gated by the full CI
      // build + test + lint matrix, so minors automerge too. Container and tool minors stay manual.
      description: "Automerge minor npm updates",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor"],
      automerge: true,
    },
    {
      // "bump", not the default "replace"/"update-lockfile": raise the package.json range with
      // the lockfile, so the manifest states the version actually tested.
      description: "Bump manifest ranges, not only the lockfile",
      matchManagers: ["npm"],
      rangeStrategy: "bump",
    },

    // ── 3. Toolchain groups: every pin of one tool moves in ONE PR, reviewed by a human ───────
    // These pins must agree across files, so an ungrouped PR that bumps one of them could never be
    // consistent. A groupName that matches nothing fails silently: re-check the depNames below if
    // a toolchain bump ever arrives as several PRs.
    {
      // .mise/config.toml `node` (mise), the Dockerfile's `ARG NODE_VERSION` (customManager) and
      // package.json `engines.node` (npm manager).
      description: "node: mise pin, Dockerfile ARG and engines.node together",
      matchDepNames: ["node"],
      groupName: "node",
      automerge: false,
    },
    {
      // .mise/config.toml `pnpm` (mise), package.json `packageManager` and
      // `devEngines.packageManager` (npm), and the Dockerfile `ARG PNPM_VERSION` (regex). pnpm
      // re-execs the packageManager version, so a split pin means the mise one never actually runs.
      description: "pnpm: mise pin, packageManager, devEngines and Dockerfile ARG together",
      matchDepNames: ["pnpm"],
      groupName: "pnpm",
      automerge: false,
    },
    {
      // The image's pinned tools: yt-dlp with its hashes in scripts/image/requirements.txt
      // (the pip_requirements manager below, which rewrites the hashes with the pin). A human
      // looks first: `mise run ci` builds the image (so the hashes must install) but never
      // runs it, and the release smoke test that does run yt-dlp only happens after merge.
      // `build(image)`, never a `feat!`: a bundled tool's major is not a breaking change of
      // Uroboros. yt-dlp is the only downloader; no other is tracked.
      description: "Image tools: the pinned yt-dlp, reviewed",
      matchManagers: ["pip_requirements"],
      matchDepNames: ["yt-dlp"],
      groupName: "image tools",
      semanticCommitType: "build",
      semanticCommitScope: "image",
      commitMessageTopic: "tool {{depName}}",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}}):",
      automerge: false,
    },
    {
      // The image's ffmpeg: the mirror image built in the upstream-builder repository from yt-dlp's
      // static GPL build, the Dockerfile's `FROM <image>:<tag>@<digest> AS ffmpeg` (the dockerfile
      // manager moves tag and digest together). It is the public GHCR copy, looked up without
      // credentials (the forge's registry holds the same build). Its tags are
      // `autobuild-YYYY-MM-DD-HH-MM`, which no built-in scheme orders, hence the regex: year as
      // major, then month, day, hour and minute, compared as numbers (`revision` is the minute).
      // Reviewed, like yt-dlp's pin: `build(image)`, never a `feat!`, as a bundled tool's major is
      // not a breaking change of Uroboros.
      //
      // No soak here (`minimumReleaseAge: null`), and a schedule instead. The docker datasource
      // takes a release timestamp only from Docker Hub's `tag_last_pushed`, so on GHCR every tag
      // and every digest-only rebuild would stay pending forever under the top-level soak (as for
      // Renovate's own GHCR image below). The soak exists for exposure to third-party releases; the mirror
      // is the owner's own repackaging, and upstream-builder has no soak of its own. What enforces
      // one is this window and the human-reviewed PR: upstream-builder mirrors on the 1st, so a PR
      // opened on the 4th or later comes at least 3 days after the upstream build, whose date the
      // tag name carries.
      description: "The ffmpeg mirror image, reviewed",
      matchDatasources: ["docker"],
      matchDepNames: ["ghcr.io/aaldebs99/ffmpeg-ytdlp"],
      versioning: "regex:^autobuild-(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})-(?<build>\\d{2})-(?<revision>\\d{2})$",
      semanticCommitType: "build",
      semanticCommitScope: "image",
      commitMessageTopic: "tool ffmpeg",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}}):",
      minimumReleaseAge: null,
      schedule: ["* * 4-31 * *"],
      automerge: false,
    },
    {
      // jellyfin-ffmpeg, the transcoder (Dockerfile, custom manager below): reviewed like the
      // download ffmpeg, `build(image)`, never a `feat!`; the soak applies (GitHub releases carry
      // their dates). A new major also renames the package (jellyfin-ffmpeg8), which the
      // Dockerfile's URL and the smoke test name, so it needs a hand anyway.
      description: "jellyfin-ffmpeg, reviewed",
      matchDepNames: ["jellyfin/jellyfin-ffmpeg"],
      semanticCommitType: "build",
      semanticCommitScope: "image",
      commitMessageTopic: "tool jellyfin-ffmpeg",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}}):",
      automerge: false,
    },
    {
      // package.json runs two compilers side by side: `@typescript/native` is an alias for
      // `typescript@7` (the native `tsc` that typecheck/build run), and `typescript` is an alias
      // for `@typescript/typescript6`, the JS API that typescript-eslint loads (it does not
      // support TS 7 yet). The aliases resolve by packageName, so each tracks its own line. Group
      // them with typescript-eslint and keep a human in the loop: once typescript-eslint accepts
      // TS 7, collapse to a plain `typescript` pin instead of merging another bump.
      description: "TypeScript compilers (native 7 + TS 6 API alias) and typescript-eslint together",
      matchManagers: ["npm"],
      matchPackageNames: ["typescript", "@typescript/typescript6", "typescript-eslint"],
      groupName: "typescript",
      automerge: false,
    },

    {
      // The image .github/workflows/renovate.yml runs (github-actions manager, docker datasource)
      // and the validator `mise run lint:renovate` pins (customManager below) are one release
      // train; one PR moves both, so the config is validated by the version that runs it once the
      // PR lands. Renovate ships minors weekly and they are as safe as its patches, so minor,
      // patch and digest updates merge themselves (`lint:renovate` still gates the config). A
      // major is where config keys get removed; it does not match this rule, so it arrives as a
      // reviewed PR. `ci(renovate)`, never a `feat`/`fix`: a tooling bump must not cut a release
      // (scripts/release/propose.sh releases on feat, fix, perf, revert, deps or a breaking change).
      description: "Renovate: workflow image and config validator together, self-merging",
      matchDepNames: ["renovate", "ghcr.io/renovatebot/renovate"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "renovate",
      semanticCommitType: "ci",
      semanticCommitScope: "renovate",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}}):",
      automerge: true,
    },
    {
      // GHCR returns no release timestamps, so under the soak (and Renovate's default
      // minimumReleaseAgeBehaviour "timestamp-required") every update of the GHCR image would be
      // held forever. Look the image up on Docker Hub instead, where Renovate publishes the same
      // multi-arch index under the same digest and every tag carries its push time, so the image
      // soaks and moves with the validator. The workflow still pulls from GHCR.
      description: "Renovate's GHCR image: versions, digests and timestamps from Docker Hub's copy",
      matchDepNames: ["ghcr.io/renovatebot/renovate"],
      overridePackageName: "renovate/renovate",
    },

    // ── 4. Manager-specific fixes ─────────────────────────────────────────────────────────────
    {
      // The Dockerfile's `FROM node:${NODE_VERSION}` cannot be
      // written back through an ARG substitution; the ARG customManager below owns those pins.
      description: "Dockerfile FROM lines using ARG-substituted node are owned by the ARG manager",
      matchManagers: ["dockerfile"],
      matchDepNames: ["node"],
      enabled: false,
    },
  ],

  // yt-dlp's pin and sha256 hashes for the image. Named explicitly (the default pattern
  // would match too) so the file this manager owns is stated where the policy is.
  pip_requirements: {
    managerFilePatterns: ["/^scripts/image/requirements\\.txt$/"],
  },

  customManagers: [
    {
      // Inline annotations for plain version strings in env/shell/YAML files:
      //   # renovate: datasource=github-releases depName=foo/bar
      //   FOO_VERSION=1.2.3        (or `foo_version: "1.2.3"`)
      // The Dockerfile is deliberately NOT matched here; its own manager below owns its ARGs.
      customType: "regex",
      description: "Annotated `# renovate:` dependencies",
      managerFilePatterns: ["/(^|/)\\.env(\\.[^/]+)?$/", "/\\.sh$/", "/\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      // Annotated ARGs in the Dockerfile:
      //   # renovate: datasource=docker depName=node
      //   ARG NODE_VERSION=24.21.0
      // depName "node" puts NODE_VERSION in the toolchain group above; anything else annotated
      // the same way is tracked on its own.
      customType: "regex",
      description: "Annotated ARG pins in the Dockerfile",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s*\\nARG\\s+\\S+="?(?<currentValue>[^"\\s]+)"?',
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}docker{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      // jellyfin-ffmpeg, the transcoder: the Dockerfile's release tag and the .deb's sha256 move
      // together. github-release-attachments finds the attachment of the pinned release whose
      // sha256 is the pinned one and hashes the same attachment of the new release. The annotated
      // ARG manager above does not match these lines (they carry no `# renovate:` comment).
      customType: "regex",
      description: "jellyfin-ffmpeg's release and .deb checksum in the Dockerfile",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "ARG JELLYFIN_FFMPEG_VERSION=(?<currentValue>v\\S+)\\nARG JELLYFIN_FFMPEG_SHA256=(?<currentDigest>[0-9a-f]{64})",
      ],
      depNameTemplate: "jellyfin/jellyfin-ffmpeg",
      datasourceTemplate: "github-release-attachments",
      versioningTemplate: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$",
    },
    {
      // The pinned validator in the `lint:renovate` task (`pnpm dlx ... --package renovate@X`).
      customType: "regex",
      description: "renovate-config-validator version in .mise/config.toml",
      managerFilePatterns: ["/^\\.mise/config\\.toml$/"],
      matchStrings: ['pnpm dlx .*--package renovate@(?<currentValue>[0-9][^\\s"]*)'],
      depNameTemplate: "renovate",
      datasourceTemplate: "npm",
    },
  ],
}
