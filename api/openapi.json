{
  "components": {
    "parameters": {},
    "schemas": {
      "AdminUser": {
        "properties": {
          "claimsSyncedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isBootstrap": {
            "type": "boolean"
          },
          "lastLoginAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "method": {
            "$ref": "#/components/schemas/AuthMethod"
          },
          "revoked": {
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName",
          "username",
          "email",
          "role",
          "method",
          "disabled",
          "revoked",
          "isBootstrap",
          "lastLoginAt",
          "claimsSyncedAt"
        ],
        "type": "object"
      },
      "AdminUserPatch": {
        "properties": {
          "disabled": {
            "type": "boolean"
          },
          "displayName": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "type": "object"
      },
      "ApiErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ApiErrorCode"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ApiErrorCode": {
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "conflict",
          "payload_too_large",
          "unprocessable",
          "too_many_requests",
          "internal",
          "unavailable"
        ],
        "type": "string"
      },
      "ApiTokenView": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "lastUsedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt",
          "lastUsedAt"
        ],
        "type": "object"
      },
      "AuthMethod": {
        "enum": [
          "local",
          "oidc"
        ],
        "type": "string"
      },
      "AuthMethods": {
        "properties": {
          "local": {
            "type": "boolean"
          },
          "oidc": {
            "nullable": true,
            "properties": {
              "displayName": {
                "type": "string"
              },
              "ready": {
                "type": "boolean"
              }
            },
            "required": [
              "displayName",
              "ready"
            ],
            "type": "object"
          }
        },
        "required": [
          "local",
          "oidc"
        ],
        "type": "object"
      },
      "ChangePasswordBody": {
        "properties": {
          "currentPassword": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "newPassword": {
            "maxLength": 1024,
            "minLength": 12,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "DependencyName": {
        "enum": [
          "database",
          "valkey"
        ],
        "type": "string"
      },
      "Info": {
        "properties": {
          "name": {
            "enum": [
              "uroboros"
            ],
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "type": "object"
      },
      "Liveness": {
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "LocalLoginBody": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "LogoutResult": {
        "properties": {
          "endSessionUrl": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "endSessionUrl"
        ],
        "type": "object"
      },
      "Me": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isBootstrap": {
            "type": "boolean"
          },
          "method": {
            "$ref": "#/components/schemas/AuthMethod"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "displayName",
          "email",
          "role",
          "method",
          "isBootstrap"
        ],
        "type": "object"
      },
      "NewApiToken": {
        "properties": {
          "secret": {
            "type": "string"
          },
          "token": {
            "$ref": "#/components/schemas/ApiTokenView"
          }
        },
        "required": [
          "token",
          "secret"
        ],
        "type": "object"
      },
      "NewApiTokenBody": {
        "properties": {
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "NewLocalUserBody": {
        "properties": {
          "displayName": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 12,
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "$ref": "#/components/schemas/Username"
          }
        },
        "required": [
          "username",
          "displayName",
          "role",
          "password"
        ],
        "type": "object"
      },
      "PushDevice": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "failedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/PushDeviceId"
          },
          "label": {
            "type": "string"
          },
          "lastSuccessAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "createdAt",
          "lastSuccessAt",
          "failedAt"
        ],
        "type": "object"
      },
      "PushDeviceId": {
        "format": "uuid",
        "type": "string"
      },
      "PushSubscriptionBody": {
        "properties": {
          "auth": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "endpoint": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "label": {
            "maxLength": 512,
            "type": "string"
          },
          "p256dh": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "endpoint",
          "p256dh",
          "auth",
          "label"
        ],
        "type": "object"
      },
      "PushTestOutcome": {
        "enum": [
          "delivered",
          "gone",
          "failed"
        ],
        "type": "string"
      },
      "PushTestResult": {
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/PushTestOutcome"
          }
        },
        "required": [
          "outcome"
        ],
        "type": "object"
      },
      "PushView": {
        "properties": {
          "devices": {
            "items": {
              "$ref": "#/components/schemas/PushDevice"
            },
            "type": "array"
          },
          "enabled": {
            "type": "boolean"
          },
          "maxDevices": {
            "exclusiveMinimum": true,
            "minimum": 0,
            "type": "integer"
          },
          "publicKey": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "enabled",
          "publicKey",
          "devices",
          "maxDevices"
        ],
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "failing": {
            "items": {
              "$ref": "#/components/schemas/DependencyName"
            },
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/ReadinessStatus"
          }
        },
        "required": [
          "status",
          "failing"
        ],
        "type": "object"
      },
      "ReadinessStatus": {
        "enum": [
          "ok",
          "degraded",
          "starting"
        ],
        "type": "string"
      },
      "ResetPasswordBody": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 12,
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "Role": {
        "enum": [
          "admin",
          "member"
        ],
        "type": "string"
      },
      "SessionView": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "lastSeenAt": {
            "format": "date-time",
            "type": "string"
          },
          "userAgent": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "current",
          "userAgent",
          "createdAt",
          "lastSeenAt"
        ],
        "type": "object"
      },
      "Username": {
        "pattern": "^[a-z0-9._-]{1,64}$",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Uroboros API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/users": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdminUser"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Users"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Admins only"
          }
        },
        "summary": "Every user",
        "tags": [
          "admin"
        ]
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewLocalUserBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUser"
                }
              }
            },
            "description": "The user"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "The username is taken"
          }
        },
        "summary": "Create a local account",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/users/oidc-sync": {
      "post": {
        "responses": {
          "204": {
            "description": "Pass finished (or OIDC is not set up)"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Admins only"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "A pass is already running"
          }
        },
        "summary": "Refresh every SSO user's groups and role from the provider now",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/users/{id}": {
      "delete": {
        "parameters": [
          {
            "description": "User id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "User id",
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "No such user"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Not allowed for this user"
          }
        },
        "summary": "Delete a local account",
        "tags": [
          "admin"
        ]
      },
      "patch": {
        "parameters": [
          {
            "description": "User id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "User id",
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUserPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUser"
                }
              }
            },
            "description": "The user"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "No such user"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Not allowed for this user (SSO, yourself or the bootstrap admin)"
          }
        },
        "summary": "Change a user's role, name, or disable or enable them",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/users/{id}/password": {
      "post": {
        "parameters": [
          {
            "description": "User id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "User id",
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Set"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "No such user"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Not a local account"
          }
        },
        "summary": "Set a local user's password; signs them out everywhere",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/auth/local/login": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalLoginBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Signed in; the session and CSRF cookies are set"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Wrong username or password"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "The account is disabled"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Local sign-in is turned off"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Too many failed attempts; try again later"
          }
        },
        "summary": "Sign in with a local username and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResult"
                }
              }
            },
            "description": "Signed out; where to send the browser next"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Signed in with an API token, which has no session"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Not signed in"
          }
        },
        "summary": "Sign out of this browser",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/methods": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMethods"
                }
              }
            },
            "description": "Sign-in methods"
          }
        },
        "summary": "The sign-in methods this server offers",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/oidc/callback": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "maxLength": 4096,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "maxLength": 256,
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Into the app, or back with ?auth_error=…"
          }
        },
        "summary": "The provider's redirect back after sign-in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/oidc/login": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "returnTo",
            "required": false,
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "To the provider, or back with ?auth_error=unavailable"
          }
        },
        "summary": "Start signing in with the OIDC provider (redirects to it)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            },
            "description": "The process answers"
          }
        },
        "summary": "Liveness: the process is up"
      }
    },
    "/api/info": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            },
            "description": "Service info"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "Service name and version"
      }
    },
    "/api/me": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "The caller"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Not signed in"
          }
        },
        "summary": "The signed-in user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/me/password": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Changed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "The current password is wrong"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "An SSO account has no password here"
          }
        },
        "summary": "Change the caller's password (local accounts); signs out the other sessions",
        "tags": [
          "account"
        ]
      }
    },
    "/api/me/push": {
      "get": {
        "responses": {
          "200": {
            "content": {
