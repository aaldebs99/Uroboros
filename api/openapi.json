{
  "components": {
    "parameters": {},
    "schemas": {
      "ApiErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ApiErrorCode"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ApiErrorCode": {
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "conflict",
          "payload_too_large",
          "unprocessable",
          "too_many_requests",
          "internal",
          "unavailable"
        ],
        "type": "string"
      },
      "AuthMethod": {
        "enum": [
          "local",
          "oidc"
        ],
        "type": "string"
      },
      "AuthMethods": {
        "properties": {
          "local": {
            "type": "boolean"
          },
          "oidc": {
            "nullable": true,
            "properties": {
              "displayName": {
                "type": "string"
              },
              "ready": {
                "type": "boolean"
              }
            },
            "required": [
              "displayName",
              "ready"
            ],
            "type": "object"
          }
        },
        "required": [
          "local",
          "oidc"
        ],
        "type": "object"
      },
      "DependencyName": {
        "enum": [
          "database",
          "valkey"
        ],
        "type": "string"
      },
      "Info": {
        "properties": {
          "name": {
            "enum": [
              "uroboros"
            ],
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "type": "object"
      },
      "Liveness": {
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "LocalLoginBody": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "LogoutResult": {
        "properties": {
          "endSessionUrl": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "endSessionUrl"
        ],
        "type": "object"
      },
      "Me": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isBootstrap": {
            "type": "boolean"
          },
          "method": {
            "$ref": "#/components/schemas/AuthMethod"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "displayName",
          "email",
          "role",
          "method",
          "isBootstrap"
        ],
        "type": "object"
      },
      "PushDevice": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "failedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/PushDeviceId"
          },
          "label": {
            "type": "string"
          },
          "lastSuccessAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "createdAt",
          "lastSuccessAt",
          "failedAt"
        ],
        "type": "object"
      },
      "PushDeviceId": {
        "format": "uuid",
        "type": "string"
      },
      "PushSubscriptionBody": {
        "properties": {
          "auth": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "endpoint": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "label": {
            "maxLength": 512,
            "type": "string"
          },
          "p256dh": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "endpoint",
          "p256dh",
          "auth",
          "label"
        ],
        "type": "object"
      },
      "PushTestOutcome": {
        "enum": [
          "delivered",
          "gone",
          "failed"
        ],
        "type": "string"
      },
      "PushTestResult": {
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/PushTestOutcome"
          }
        },
        "required": [
          "outcome"
        ],
        "type": "object"
      },
      "PushView": {
        "properties": {
          "devices": {
            "items": {
              "$ref": "#/components/schemas/PushDevice"
            },
            "type": "array"
          },
          "enabled": {
            "type": "boolean"
          },
          "maxDevices": {
            "exclusiveMinimum": true,
            "minimum": 0,
            "type": "integer"
          },
          "publicKey": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "enabled",
          "publicKey",
          "devices",
          "maxDevices"
        ],
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "failing": {
            "items": {
              "$ref": "#/components/schemas/DependencyName"
            },
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/ReadinessStatus"
          }
        },
        "required": [
          "status",
          "failing"
        ],
        "type": "object"
      },
      "ReadinessStatus": {
        "enum": [
          "ok",
          "degraded",
          "starting"
        ],
        "type": "string"
      },
      "Role": {
        "enum": [
          "admin",
          "member"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Uroboros API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/local/login": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalLoginBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Signed in; the session and CSRF cookies are set"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Wrong username or password"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "The account is disabled"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Local sign-in is turned off"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Too many failed attempts; try again later"
          }
        },
        "summary": "Sign in with a local username and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResult"
                }
              }
            },
            "description": "Signed out; where to send the browser next"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Signed in with an API token, which has no session"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Not signed in"
          }
        },
        "summary": "Sign out of this browser",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/methods": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMethods"
                }
              }
            },
            "description": "Sign-in methods"
          }
        },
        "summary": "The sign-in methods this server offers",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            },
            "description": "The process answers"
          }
        },
        "summary": "Liveness: the process is up"
      }
    },
    "/api/info": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            },
            "description": "Service info"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "Service name and version"
      }
    },
    "/api/me": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "The caller"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Not signed in"
          }
        },
        "summary": "The signed-in user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/me/push": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushView"
                }
              }
            },
            "description": "Push and the caller's devices"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "Whether this server pushes, its VAPID key, and the caller's devices",
        "tags": [
          "push"
        ]
      }
    },
    "/api/me/push/devices": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushSubscriptionBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushDevice"
                }
              }
            },
            "description": "The device"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Not a subscription on an allowed push service"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Push is off on this server"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "The caller has as many devices as allowed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "Turn notifications on for the browser whose subscription this is",
        "tags": [
          "push"
        ]
      }
    },
    "/api/me/push/devices/{id}": {
      "delete": {
        "parameters": [
          {
            "description": "Device id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/PushDeviceId"
                },
                {
                  "description": "Device id"
                }
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Not a device id"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "No such device of the caller's"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "Turn notifications off for one of the caller's devices",
        "tags": [
          "push"
        ]
      }
    },
    "/api/me/push/devices/{id}/test": {
      "post": {
        "parameters": [
          {
            "description": "Device id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/PushDeviceId"
                },
                {
                  "description": "Device id"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushTestResult"
                }
              }
            },
            "description": "How it went"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Not a device id"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "No such device of the caller's"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Push is off on this server"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "Send one of the caller's devices a test notification",
        "tags": [
          "push"
        ]
      }
    },
    "/api/ready": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Ready; `degraded` names the failing dependencies but still takes traffic"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "Unexpected error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Still starting: connecting to the database or running migrations"
          }
        },
        "summary": "Readiness and dependency health"
      }
    }
  }
}
