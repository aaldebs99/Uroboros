# https://editorconfig.org — kept consistent with oxfmt (.oxfmtrc.json).
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[{Dockerfile,Dockerfile.*,*.sh}]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab
