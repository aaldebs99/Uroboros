{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "workerSuffix": {
          "type": "string"
        },
        "workerDigest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publicBaseUrl": {
      "type": "string",
      "pattern": "^(https?://[^\\s/?#@]+/?)?$"
    },
    "push": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "pattern": "^((mailto:|https://).+)?$"
        },
        "vapid": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publicKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]*$"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.-]+$"
          }
        },
        "maxDevices": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "hpa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "cpu": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "bodyLimitBytes": {
          "type": "integer",
          "minimum": 1
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "shutdownGraceSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "dbStartupGraceSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "startupTimeoutSeconds": {
          "type": "integer",
          "minimum": 10
        },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "topologySpread": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "topologyKey": {
              "type": "string",
              "minLength": 1
            },
            "maxSkew": {
              "type": "integer",
              "minimum": 1
            },
            "whenUnsatisfiable": {
              "type": "string",
              "enum": ["ScheduleAnyway", "DoNotSchedule"]
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "scratchSize": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 26
        },
        "cookies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host"],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": ["Prefix", "Exact", "ImplementationSpecific"]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dns": {
          "type": "object",
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "internetExcept": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "valkey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "allowCidrs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cidr"],
            "additionalProperties": false,
            "properties": {
              "cidr": {
                "type": "string"
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionTtlHours": {
          "type": "integer",
          "minimum": 1
        },
        "trustProxy": {
          "type": "boolean"
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "bootstrap": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "usernameKey": {
                  "type": "string",
                  "minLength": 1
                },
                "passwordKey": {
                  "type": "string",
                  "minLength": 1
                },
                "allowWeakPassword": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^(https://.+)?$"
            },
            "clientId": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "clientSecretKey": {
              "type": "string",
              "minLength": 1
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            },
            "adminGroups": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "groupsClaim": {
              "type": "string",
              "minLength": 1
            },
            "syncIntervalSecs": {
              "description": "0 turns the background sync off; otherwise at least 60",
              "type": "integer",
              "anyOf": [
                {
                  "const": 0
                },
                {
                  "minimum": 60
                }
              ]
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["s3", "filesystem"]
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "bucket": {
              "type": "string"
            },
            "forcePathStyle": {
              "type": "boolean"
            },
            "publicUrl": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "accessKeyIdKey": {
              "type": "string",
              "minLength": 1
            },
            "secretAccessKeyKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "mountPath": {
              "type": "string",
              "pattern": "^/"
            },
            "layout": {
              "type": "string"
            }
          }
        }
      }
    },
    "downloads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxActivePerUser": {
          "type": "integer",
          "minimum": 1
        },
        "maxPlaylistEntries": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
