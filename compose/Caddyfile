# Caddy for the local compose stack: one entrypoint in front of uroboros. `dynamic a` re-resolves
# the `uroboros` service name every two seconds, so a restarted container, or replicas added with
# `docker compose up --scale uroboros=N`, are picked up and served round-robin.
{
	admin off
	auto_https off
}

:8080 {
	reverse_proxy {
		dynamic a {
			name uroboros
			port 8080
			refresh 2s
		}
		lb_policy round_robin
	}
}
